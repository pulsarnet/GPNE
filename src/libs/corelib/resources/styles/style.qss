QTableView {
    /* background: white; */
}


QToolTip {
    background-color: lightgray;
    color: black;
    border: 1px solid gray;
    padding: 5px;
    border-radius: 3px;
}

QDockWidget::title {
    text-align: left;
    background: white;
    border: none;
    padding-top: 5px;
    padding-bottom: 5px;
}
